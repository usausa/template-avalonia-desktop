<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="http://smart/avalonia"
             xmlns:models="using:Template.DesktopApp.Models"
             xmlns:module="clr-namespace:Template.DesktopApp.Views.Home"
             mc:Ignorable="d"
             x:Class="Template.DesktopApp.Views.Home.HomeView"
             x:DataType="module:HomeViewModel"
             s:DataContextResolver.Type="module:HomeViewModel"
             d:DesignWidth="1040" d:DesignHeight="756">

    <UserControl.Styles>
        <Style Selector="UniformGrid.metrics">
            <Setter Property="Columns" Value="4" />
            <Setter Property="RowSpacing" Value="16" />
            <Setter Property="ColumnSpacing" Value="16" />
        </Style>
        <ContainerQuery Name="Page"
                        Query="max-width:720">
            <Style Selector="UniformGrid.metrics">
                <Setter Property="Columns" Value="2" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>

    <!-- Content -->
    <ScrollViewer>
        <StackPanel Classes="page"
                    Container.Name="Page" Container.Sizing="Width">

            <!-- Header -->
            <StackPanel Classes="page-header">
                <TextBlock Classes="page-title"
                           Text="Home" />
                <TextBlock Classes="page-description"
                           Text="Template project for Avalonia desktop." />
            </StackPanel>

            <!-- Metric -->
            <UniformGrid Classes="metrics">
                <Border Classes="card">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="caption"
                                   Text="Open tasks" />
                        <TextBlock Classes="metric"
                                   Text="{Binding OpenCount}" />
                        <TextBlock Classes="caption"
                                   Text="{Binding TotalCount, StringFormat='{}of {0} tasks'}" />
                    </StackPanel>
                </Border>
                <Border Classes="card">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="caption"
                                   Text="Completed" />
                        <TextBlock Classes="metric"
                                   Text="{Binding DoneCount}" />
                        <TextBlock Classes="caption positive"
                                   Text="{Binding DonePercent, StringFormat='{}{0:0}% done'}" />
                    </StackPanel>
                </Border>
                <Border Classes="card">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="caption"
                                   Text="Overdue" />
                        <TextBlock Classes="metric"
                                   Text="{Binding OverdueCount}" />
                        <TextBlock Classes="caption negative"
                                   Text="Past the due date" />
                    </StackPanel>
                </Border>
                <Border Classes="card">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="caption"
                                   Text="Planned hours" />
                        <TextBlock Classes="metric"
                                   Text="{Binding PlannedHours, StringFormat='{}{0:0}h'}" />
                        <TextBlock Classes="caption"
                                   Text="For open tasks" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Progress -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Classes="section-title"
                                   Text="Progress" />
                        <TextBlock Grid.Column="1"
                                   Classes="section-title"
                                   Text="{Binding DonePercent, StringFormat='{}{0:0}%'}" />
                    </Grid>
                    <ProgressBar Value="{Binding DonePercent}"
                                 Minimum="0" Maximum="100" />
                    <TextBlock Classes="caption">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} of {1} tasks completed">
                                <Binding Path="DoneCount" />
                                <Binding Path="TotalCount" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Upcoming -->
            <Border Classes="card"
                    Padding="0">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto"
                          Margin="16,12">
                        <TextBlock Grid.Column="0"
                                   Classes="section-title"
                                   VerticalAlignment="Center"
                                   Text="Upcoming tasks" />
                        <HyperlinkButton Grid.Column="1"
                                         Command="{Binding ListCommand}"
                                         Content="View all" />
                    </Grid>
                    <TableView ItemsSource="{Binding UpcomingTasks}">
                        <TableView.Columns>
                            <TableViewColumn Width="3*"
                                             Binding="{Binding Name}"
                                             Header="Task" />
                            <TableViewColumn Width="1.4*"
                                             Header="Assignee">
                                <TableViewColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:TaskItem">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8">
                                            <Border Classes="avatar"
                                                    Background="{Binding Assignee.Color}">
                                                <TextBlock Text="{Binding Assignee.Name, Converter={StaticResource InitialConverter}}" />
                                            </Border>
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{Binding Assignee.Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </TableViewColumn.CellTemplate>
                            </TableViewColumn>
                            <TableViewColumn Width="1.3*"
                                             Header="Status">
                                <TableViewColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:TaskItem">
                                        <Border Classes="badge"
                                                Classes.attention="{Binding State, Converter={s:CompareToBool}, ConverterParameter={x:Static models:TaskState.InProgress}}"
                                                Classes.caution="{Binding State, Converter={s:CompareToBool}, ConverterParameter={x:Static models:TaskState.InReview}}"
                                                Classes.success="{Binding State, Converter={s:CompareToBool}, ConverterParameter={x:Static models:TaskState.Done}}">
                                            <TextBlock Text="{Binding State, Converter={StaticResource TaskStateTextConverter}}" />
                                        </Border>
                                    </DataTemplate>
                                </TableViewColumn.CellTemplate>
                            </TableViewColumn>
                            <TableViewColumn Width="1*"
                                             Binding="{Binding DueDate, StringFormat='{}{0:yyyy/MM/dd}'}"
                                             Header="Due" />
                        </TableView.Columns>
                    </TableView>
                </StackPanel>
            </Border>

            <!-- Setting -->
            <Border Classes="card">
                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="16">
                    <PathIcon Grid.Column="0"
                              Classes="card-icon"
                              Data="{StaticResource SettingsIcon}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Classes="section-title"
                                   Text="Setting" />
                        <TextBlock Classes="caption"
                                   Text="{Binding Setting}" />
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
