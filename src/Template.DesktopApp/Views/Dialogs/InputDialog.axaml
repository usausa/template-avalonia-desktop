<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Template.DesktopApp.Views.Dialogs.InputDialog"
        Width="384"
        CanResize="False"
        Title="Input"
        ShowInTaskbar="False" SizeToContent="Height" WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16">
        <TextBox x:Name="ValueText" />
        <StackPanel Orientation="Horizontal"
                    Margin="0,16,0,0"
                    Spacing="8"
                    HorizontalAlignment="Right">
            <Button Width="96"
                    Content="OK"
                    Click="OnOkClick" IsDefault="True" />
            <Button Width="96"
                    Content="Cancel"
                    Click="OnCancelClick" IsCancel="True" />
        </StackPanel>
    </StackPanel>

</Window>
