<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Template.DesktopApp.Views.Dialogs.InputDialog"
        Width="384"
        CanResize="False"
        WindowStartupLocation="CenterOwner" SizeToContent="Height" ShowInTaskbar="False"
        Title="Input">

    <StackPanel Margin="16">
        <TextBox x:Name="ValueText" />
        <StackPanel Orientation="Horizontal"
                    Margin="0,16,0,0"
                    Spacing="8"
                    HorizontalAlignment="Right">
            <Button Width="96"
                    IsDefault="True"
                    Content="OK"
                    Click="OnOkClick" />
            <Button Width="96"
                    IsCancel="True"
                    Content="Cancel"
                    Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>

</Window>
